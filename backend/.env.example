PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================================
# DATABASE — REQUIRED for persistent storage (accounts won't reset)
# ============================================================
# Option A: MongoDB Atlas (Free Cloud) — Recommended
#   1. Visit https://cloud.mongodb.com and create a free cluster
#   2. Click "Connect" -> "Connect your application"
#   3. Copy the connection string and paste it below
#
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moodverse?retryWrites=true&w=majority
#
# Option B: Local MongoDB (if installed on your machine)
MONGODB_URI=mongodb://localhost:27017/moodverse

# ============================================================
# AUTH — REQUIRED
# ============================================================
# Use a long random string (min 32 characters)
JWT_SECRET=replace_this_with_a_very_long_random_secret_key_at_least_32_chars

# ============================================================
# AI ENGINE — OPTIONAL (falls back to rule-based engine if not set)
# ============================================================
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# REDIS — OPTIONAL (falls back to in-memory cache if not set)
# ============================================================
REDIS_URL=redis://localhost:6379
